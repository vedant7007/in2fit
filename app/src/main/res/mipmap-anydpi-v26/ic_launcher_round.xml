<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon. Without one the phone shows Android's default robot captioned IN2FIT
     (Arjun's logcat, 20 Sep: "Default app icon returned from PackageManager"). An adaptive
     icon: a plain background colour and a bowl glyph. A designed icon replaces these two
     files and nothing else. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
