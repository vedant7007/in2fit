<?xml version="1.0" encoding="utf-8"?>
<!--
  THE DEFAULT STRING TABLE. Every user-visible string in the app is a key here, and nowhere else.

  HOW LOCALISATION WORKS IN THIS PROJECT (docs/decisions/0017)
  - This file is the fallback. It must be complete: a key that is not here does not exist.
  - values-te/, values-hi/ and values-en/ hold the same keys in Telugu, Hindi and English. A key
    missing from a locale file falls back to the text here AT RUNTIME, visibly, on the phone.
    That fallback is the honest state of an untranslated string. Never fill a locale file with
    placeholder text or a machine translation to make it look complete.
  - No Telugu string ships without review by a fluent speaker. See values-te/strings.xml.
  - Nothing is hardcoded in a composable: StringResourcesTest fails the build on a literal
    passed to Text(...) or a text parameter in ui/.
  - The rules engine's sentences are the trigger_* keys below (db099ca). The engine emits a
    template id and the evidence; TriggerText renders the words from this table. A translation
    may reorder the slots; it must never add a number, and a test renders every template to
    check that no digit appears that the evidence did not supply.
  - A fluent speaker's reply comes in through tools/import_review_queue.py, never by editing
    a locale file by hand, and the check file it writes goes back to the speaker.

  Writing a string here: say what the data says, offer what someone might consider, hand the
  decision back (spec 15.2). Never a number the database did not produce. Never a condition the
  user did not declare.
-->
<resources>
    <!-- The product name. Not translated: it is a name, and JNI symbol names still encode the
         old package, so only DISPLAY strings carry the new name. -->
    <string name="app_name" translatable="false">IN2FIT</string>

    <!-- Spec 15.3: persistent and non-dismissible on every advice screen. -->
    <string name="safety_not_medical_advice">This is information, not medical advice.</string>

    <!-- Language picker (spec 10.2: the user chooses; the app never detects). Each language is
         named in its own script, as every phone's settings screen does, so a person who cannot
         read the current language can still find their own. Endonyms, not translations, so not
         translatable; the Telugu and Hindi spellings are on the review list all the same. -->
    <string name="language_telugu" translatable="false">తెలుగు</string>
    <string name="language_hindi" translatable="false">हिन्दी</string>
    <string name="language_english" translatable="false">English</string>
    <string name="language_picker_title">Language</string>

    <!-- The build-status screen. It shows what is and is not built, and no figures. -->
    <string name="status_screen_subtitle">Phase 1B scaffold. Contracts are defined; no pipeline is built yet.</string>
    <!-- Pipeline name, then its state. -->
    <string name="status_line">%1$s: %2$s</string>
    <string name="state_not_implemented">Not implemented</string>
    <string name="pipeline_voice_logging">Voice logging (ASR, LLM extract, TTS)</string>
    <string name="pipeline_nutrition_lookup">Nutrition lookup</string>
    <string name="pipeline_timeline_query">Timeline and voice query</string>
    <string name="pipeline_lab_report_scan">Lab report scan</string>
    <string name="pipeline_adaptive_suggestions">Adaptive suggestions</string>
    <string name="pipeline_dish_first_guess">Camera dish first guess</string>
    <string name="pipeline_exercise_form">Exercise form check</string>

    <!-- Confidence bands, spec 15.1.1. Shown inline with every figure, never as a percentage. -->
    <string name="confidence_band_good">Good</string>
    <string name="confidence_band_approximate">Approximate</string>
    <string name="confidence_band_rough">Rough</string>

    <!-- One sentence per ConfidenceReason, shown on tap (spec 15.3). Confidence.kt says a reason
         with no sentence here is a bug, so adding a reason there means adding a line here. Keys
         are the enum constant, lowercased. -->
    <string name="confidence_reason_exact_food_match">Matched exactly to a food in the database.</string>
    <string name="confidence_reason_fuzzy_food_match">Matched to the closest name in the database; check it is the food you meant.</string>
    <string name="confidence_reason_category_level_match">Matched only to a food category, not a specific food.</string>
    <string name="confidence_reason_quantity_stated">You gave the quantity in a unit we can convert.</string>
    <string name="confidence_reason_household_unit_default">A household measure was converted with a standard weight. Tap to correct the grams.</string>
    <string name="confidence_reason_quantity_inferred">You did not say how much, so this quantity is a guess. Tap to correct it.</string>
    <string name="confidence_reason_authored_reference_recipe">Based on a reference recipe. Edit it to match how you cook.</string>
    <string name="confidence_reason_user_edited_recipe">Based on the recipe as you edited it.</string>
    <string name="confidence_reason_weak_source_record">The source record for this food rests on few samples or on a label.</string>
    <string name="confidence_reason_substitute_food_record">The nearest record is a similar food, not this one.</string>
    <string name="confidence_reason_low_asr_confidence">Speech recognition was unsure of what it heard. Check the words.</string>
    <string name="confidence_reason_uncorrected_camera_guess">A camera guess that has not been confirmed by you.</string>

    <!-- ================================================================================
         THE RULES ENGINE'S SENTENCES. Added by Rao, 20 Sep; the wording is Nila's to review.

         One key per TriggerTemplate constant, lowercased, the same rule as confidence_reason_*.
         The engine emits WHICH sentence and the evidence; TriggerText puts these words around
         it. These are the health sentences: spec 15.1 and 15.2 apply to every one, in every
         language. Never name a disease the user has not declared. Never prescribe. Cite the
         range PRINTED ON THEIR OWN REPORT. Hand the decision back.

         Positional arguments, supplied by TriggerText.render in this order. A translation may
         reorder them; it must not add a number of its own:
           trigger_escalate_*, trigger_lab_*   %1 report date  %2 test name  %3 value  %4 unit  %5 printed bound
           trigger_declared_condition          %1 condition name, as the user declared it
           trigger_meal_composition            %1 nutrient word  %2 dominant item  %3 percent
           trigger_life_context                %1 life-context phrase
           trigger_timeline                    %1 days observed  %2 description
         ================================================================================ -->
    <string name="trigger_escalate_above_range">Your report from %1$s shows %2$s at %3$s %4$s, well outside the %5$s printed on it. This is worth showing to a doctor.</string>
    <string name="trigger_escalate_below_range">Your report from %1$s shows %2$s at %3$s %4$s, well outside the %5$s printed on it. This is worth showing to a doctor.</string>
    <string name="trigger_lab_above_range">Your report from %1$s shows %2$s at %3$s %4$s, above the %5$s printed on it, so suggestions are ranked differently now.</string>
    <string name="trigger_lab_below_range">Your report from %1$s shows %2$s at %3$s %4$s, below the %5$s printed on it, so suggestions are ranked differently now.</string>
    <string name="trigger_declared_condition">You told us you are managing %1$s, so suggestions are ranked with that in mind.</string>
    <string name="trigger_meal_composition">Most of the %1$s in this meal comes from %2$s, about %3$s percent of it.</string>
    <string name="trigger_life_context">Suggestions are limited to what is realistic for %1$s.</string>
    <string name="trigger_timeline">Over the last %1$s days, %2$s.</string>

    <!-- Nutrient words, as they appear inside a sentence. One per Nutrient constant. -->
    <string name="nutrient_energy">energy</string>
    <string name="nutrient_protein">protein</string>
    <string name="nutrient_carbohydrate">carbohydrate</string>
    <string name="nutrient_fat">fat</string>
    <string name="nutrient_fibre">fibre</string>
    <string name="nutrient_iron">iron</string>
    <string name="nutrient_vitamin_b12">vitamin B12</string>
    <string name="nutrient_sodium">sodium</string>

    <!-- Life-context phrases, as they appear inside trigger_life_context. One per LifeContext. -->
    <string name="life_context_hostel_student">hostel and canteen food</string>
    <string name="life_context_pg_own_cooking">cooking for yourself with limited time</string>
    <string name="life_context_field_or_manual_worker">long physical shifts and eating out</string>
    <string name="life_context_desk_professional">a desk day with a full kitchen</string>
    <string name="life_context_homemaker">cooking for the household</string>
    <!-- ContextText: the lines that carry the person's own meals, reports and diet into an ANSWER or RECOMMEND request.
         Positional arguments in the order ContextText supplies them; no number may be added to any of these. -->
    <string name="context_figure">%1$s: %2$s %3$s</string>
    <string name="context_figure_partial">%1$s: at least %2$s %3$s (no value for %4$s)</string>
    <string name="context_figure_none">%1$s: not known</string>
    <string name="context_meal">%1$s: %2$s. %3$s</string>
    <string name="context_period">%1$s: %2$s</string>
    <string name="context_period_today">Today so far</string>
    <string name="context_period_last_seven_days">The last seven days</string>
    <string name="context_lab">%1$s: %2$s %3$s (report dated %4$s)</string>
    <string name="context_lab_with_range">%1$s: %2$s %3$s, printed range %4$s to %5$s (report dated %6$s)</string>
    <string name="context_never_suggest_vegetarian">meat, fish or eggs (vegetarian)</string>
    <string name="context_never_suggest_vegan">meat, fish, eggs, milk or any dairy (vegan)</string>
    <string name="context_never_suggest_eggetarian">meat or fish (eggetarian)</string>
    <string name="context_never_suggest_jain">meat, fish, eggs, onion, garlic or root vegetables (Jain)</string>
</resources>
